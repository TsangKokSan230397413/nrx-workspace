rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 治療師帳號設定（目前只用來存 clinicId，讓同一診所的治療師可以互看紀錄）
    // 每位治療師只能讀自己的那份設定；要新增/修改 clinicId 目前需要管理員在
    // Firebase Console 的 Firestore 資料頁面手動建立/編輯文件（見下方說明）。
    match /therapists/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // 先不開放前端寫入，避免治療師自己竄改所屬診所
    }

    // 處方箋紀錄：只有本人，或是同一個 clinicId 的治療師可以讀取
    match /prescriptions/{docId} {
      allow read: if request.auth != null && (
        resource.data.therapistUid == request.auth.uid ||
        (
          resource.data.clinicId != null &&
          resource.data.clinicId == get(/databases/$(database)/documents/therapists/$(request.auth.uid)).data.clinicId
        )
      );
      allow create: if request.auth != null && request.resource.data.therapistUid == request.auth.uid;
      allow update, delete: if false;
    }

    // 分享出去的處方箋內容（QR code / 連結開啟的內容）：
    // 建立不需要登入（治療師開處方箋時建立），讀取也不需要登入（病患掃碼時要能看到），
    // 但只允許更新 completions 欄位（病患回報完成度），不能整份改掉。
    match /shared_prescriptions/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completions']);
      allow delete: if false;
    }
  }
}
